# Copy to .env (never commit .env). Every setting is optional except the key for Gemini.

# Free key from Google AI Studio (https://aistudio.google.com) -> "Get API key"
GEMINI_API_KEY=

# gemini (the brief's setup) | local (Qwen on your own computer, no key) | fake (tests)
MCP_AGENT_PROVIDER=gemini
# small | big | a model id.  gemini: small = gemini-3.5-flash-lite, big = gemini-3.8-flash
#                            local:  small = Qwen/Qwen2.5-0.5B-Instruct, big = Qwen/Qwen2.5-3B-Instruct
MCP_AGENT_MODEL=big

# Free tiers limit requests per minute: pause after every evaluation task (seconds)
MCP_AGENT_SLEEP_S=0

# How search_notes matches: words (v2, default: ranked word match) | phrase (v1, the brief: whole query)
MCP_SEARCH_MODE=words

# Local models only: CPU threads, device (cpu | cuda | auto) and number format
MCP_AGENT_THREADS=
MCP_AGENT_DEVICE=auto
# Empty = float16 on a GPU, float32 on a CPU (float32 reads long prompts faster on CPUs)
MCP_AGENT_DTYPE=
# HF_HOME=D:\hf-cache
